# Copy to .env.local. Every key is validated by src/env.ts — a missing one fails the build.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — rule 4

# AI — Gemini via Vertex AI (service account; AI Studio free tier can't ground with Search)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_SERVICE_ACCOUNT_FILE=.secrets/vertex-service-account.json   # local (gitignored)
# GEMINI_SERVICE_ACCOUNT_JSON={...}                                # hosted: the JSON itself
GEMINI_API_KEY=                   # optional; not used by the pipeline
WAVESPEED_API_KEY=                # cover images (MiniMax image-01 via WaveSpeed) — optional
MINIMAX_API_KEY=                  # …or MiniMax directly; WaveSpeed wins if both are set
GENERATION_COVER_COST_USD=0.0035  # WaveSpeed image-01 rate
# MINIMAX_API_BASE=https://api.minimax.io   # China-platform accounts: https://api.minimaxi.com

# Generation
GENERATION_POSTS_PER_DAY=2        # ramp to 4 — see PLAN §3.2
GENERATION_AUTO_PUBLISH=false     # see PLAN §3.1
DEDUPE_TOPIC_THRESHOLD=0.86
DEDUPE_BODY_THRESHOLD=0.90
GENERATION_DAILY_COST_CAP_USD=1.50
GENERATION_GROUNDING_COST_PER_QUERY_USD=0.014   # unverified — see env.ts
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>    # pinged after each successful cron run

# Review notifications (optional) — Gmail SMTP with an App Password
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=                  # Google App Password, not your login password
# REVIEW_NOTIFY_TO=               # comma-separated; defaults to SMTP_USER

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=                      # min 32 chars — `openssl rand -hex 32`

# Later
# RESEND_API_KEY=
