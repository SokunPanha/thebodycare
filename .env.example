# Copy to .env.local. Every key is validated by src/env.ts — a missing one fails the build.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — rule 4

# AI
GEMINI_API_KEY=
MINIMAX_API_KEY=                  # cover images — optional; posts fall back to generated art
# MINIMAX_API_BASE=https://api.minimax.io   # China-platform accounts: https://api.minimaxi.com

# Generation
GENERATION_POSTS_PER_DAY=2        # ramp to 4 — see PLAN §3.2
GENERATION_AUTO_PUBLISH=false     # see PLAN §3.1
DEDUPE_TOPIC_THRESHOLD=0.86
DEDUPE_BODY_THRESHOLD=0.90
GENERATION_DAILY_COST_CAP_USD=1.50

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=                      # min 32 chars — `openssl rand -hex 32`

# Later
# RESEND_API_KEY=
